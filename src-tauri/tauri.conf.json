{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLite",
  "version": "0.1.0",
  "identifier": "com.cliplite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipLite",
        "width": 620,
        "height": 460,
        "minWidth": 360,
        "minHeight": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "ClipLite Settings",
        "width": 720,
        "height": 560,
        "resizable": false,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": false,
        "alwaysOnTop": true,
        "center": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Lightweight clipboard manager",
    "longDescription": "ClipLite is a lightweight clipboard manager for desktop text history.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
